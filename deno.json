{
	"imports": {
		"__sveltekit": "npm:@sveltejs/kit"
	},
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"unstable": ["sloppy-imports"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"./.svelte-kit/types/**/$types.d.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte"
	]
}
