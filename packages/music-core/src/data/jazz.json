  "IMPROV_TECHNIQUES": [
    {
      "id": "chord-tone-soloing",
      "name": "Chord-tone soloing",
      "summary": "Build lines from the 1 3 5 7 (and 9) of each chord. The safest, strongest note choices."
    },
    {
      "id": "parent-scale",
      "name": "One parent scale",
      "summary": "The C major scale works over every chord of a C-major ii-V-I. Aim to land lines on 1 3 5 or 7."
    },
    {
      "id": "half-step-below",
      "name": "Half-step-below approach",
      "summary": "Precede a chord tone (best of all the major 3rd) with the note a half-step below, e.g. Bb→B, Eb→E. Most effective right at the chord change."
    },
    {
      "id": "chromatic-enclosure",
      "name": "Chromatic enclosure",
      "summary": "Surround a target note from above and below before landing on it."
    },
    {
      "id": "v7-scale-change",
      "name": "Change scale over the V7",
      "summary": "Switch to the diminished (half-whole) or altered scale over the V7 to add b9 #9 #11 b13 tension, then resolve back into the key."
    },
    {
      "id": "bebop-scale",
      "name": "Bebop scales",
      "summary": "Add a chromatic passing note: dominant bebop = mixolydian + maj7; major bebop = major + #5; minor bebop = dorian + maj7 (or maj3)."
    },
    {
      "id": "sequence",
      "name": "Melodic sequence",
      "summary": "Repeat a melodic shape, moving it up or down the scale."
    },
    {
      "id": "rhythmic-variation",
      "name": "Rhythmic variation",
      "summary": "Inject triplets and 8th-note rests to keep lines from sounding mechanical."
    },
    {
      "id": "start-from-any-note",
      "name": "Start from any note",
      "summary": "Begin lines from the root, 9th, 3rd, 4th… not always the root. Varies the contour."
    },
    {
      "id": "lh-textures",
      "name": "Left-hand textures",
      "summary": "Stride (bass note then chord), bossa-nova bass (root + 5th), paradiddle (L/R/L/R) and 4-note cell patterns."
    }
  ],
