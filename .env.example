# Postgres for users and sessions. Without it, sign-in is off and the site runs signed out.
DATABASE_URL="postgresql://root:mysecretpassword@localhost:5432/local"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The site's public address, used for the OAuth redirect.
BETTER_AUTH_URL="http://localhost:5173"

# Authentik: create an OAuth2/OpenID provider and an application for this site.
# Issuer is the provider's "OpenID Configuration Issuer", for example
# https://auth.example.com/application/o/personal-site/
# Redirect URI to allow in Authentik: {BETTER_AUTH_URL}/api/auth/callback/authentik
AUTHENTIK_ISSUER=""
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""

# Set to "required" to keep the music app behind the login.
MUSIC_LOGIN=""
