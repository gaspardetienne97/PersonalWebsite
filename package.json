{
  "name": "@repo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:all": "vp run -r build",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "check:all": "vp run -r check",
    "test": "vp test",
    "test:all": "vp run -r test",
    "test:e2e": "playwright test",
    "prepare": "vp config && pnpm run i18n",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./packages/i18n/paraglide --strategy cookie preferredLanguage baseLocale --silent"
  },
